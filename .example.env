# MongoDB connection string (replace with your own cluster credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nextjs-auth-app

# Secret used to sign/verify email verification & reset tokens
TOKEN_SECRET=your_token_secret_here

# Secret used to sign/verify JWT access tokens
JWT_SECRET=your_jwt_secret_here

# Base URL of the app (used in email verification / reset links)
DOMAIN=http://localhost:3000
